# Environment variables used by the Fruition website. NAMES ONLY: this repo is public.
# Local dev: copy to .env.local (next dev) and, for `npm run preview`, to .dev.vars.
# Production: set as Worker secrets (`npx wrangler secret put NAME`) or in the Cloudflare
# dashboard. NEXT_PUBLIC_* values are inlined at build time (CI passes the Sanity ones as
# GitHub repo variables). Values live in the team password manager.
# Full inventory with what each one does: docs/cloud.md section 5.

# --- Required for `npm run dev` -------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=bt6nb58h
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity writes (portal publishing, team, onboarding) -------------------------------
SANITY_WRITE_TOKEN=

# --- Portal auth + data (Supabase "portal" project) ------------------------------------
PORTAL_SUPABASE_URL=
PORTAL_SUPABASE_ANON_KEY=
PORTAL_SUPABASE_SERVICE_ROLE_KEY=
PORTAL_ALLOWED_EMAIL_DOMAIN=fruitionservices.io

# --- Marketa (separate repo): read-only brain project + webhook base URL ---------------
MARKETA_SUPABASE_URL=
MARKETA_SUPABASE_SERVICE_ROLE_KEY=
MARKETA_URL=

# --- LLMs (all through OpenRouter) -----------------------------------------------------
OPENROUTER_API_KEY=
ASK_FRUIT_ENABLED=
ASK_FRUIT_MODEL=
ASK_FRUIT_IP_SALT=
ASK_FRUIT_VISITOR_HOURLY_TURNS=
ASK_FRUIT_VISITOR_DAILY_TURNS=
ASK_FRUIT_IP_DAILY_TURNS=
ASK_FRUIT_DAILY_BUDGET_USD=
DESIGN_DOC_MODEL=
LEAD_CLASSIFIER_MODEL=
LEAD_CLASSIFIER_SPAM=
MARKETA_SOCIAL_MODEL=

# --- Leads: monday.com, Slack, email ----------------------------------------------------
MONDAY_API_TOKEN=
MONDAY_READ_TOKEN=
MONDAY_WEBHOOK_SECRET=
MONDAY_LEADS_BOARD_ID=

MONDAY_LEADS_COMPANY_COLUMN=
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
SLACK_LEADS_CHANNEL_ID=
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# --- Booking (Calendly) -----------------------------------------------------------------
CALENDLY_API_TOKEN=
CALENDLY_WEBHOOK_SECRET=

    {
      "_key": "0a7a04d021c7",
      "_type": "vcSteps",
      "head": {
        "_type": "vcHead",
        "badge": "How our pricing works",
        "heading": "No surprise *hourly bills*",
        "lead": "Fixed fees, agreed in writing, with licences kept separate from our service fees."
      },
      "items": [
        {
          "_key": "259c51062bab",
          "_type": "vcStep",
          "body": "Every package and initial phase has a fixed price, agreed in writing before work starts.",
          "bullets": [],
          "n": "01",
          "title": "Fixed fee per phase"
        },
        {
          "_key": "0f024e06e05c",
          "_type": "vcStep",
          "body": "Mid-scope and enterprise projects are quoted after a free scoping call or system audit.",
          "bullets": [],
          "n": "02",
          "title": "Scoped after a call"
        },
        {
          "_key": "eb4b6b54ac07",
          "_type": "vcStep",
          "body": "Consultants and pricing for Australia & NZ, South-East Asia, India & UAE, UK & Europe and US & Canada.",
          "bullets": [],
          "n": "03",
          "title": "Local pricing"
        },
        {
          "_key": "d5f624373e58",
          "_type": "vcStep",
          "body": "monday.com, Atlassian and HubSpot seats are paid to the vendor, or through our licence procurement service.",
          "bullets": [],
          "n": "04",
          "title": "Licences billed separately"
        }
      ],
      "layout": "steps s4",
      "titleClass": "title",
      "tone": "plain"
    },
    {
      "_key": "f642b8a5a96c",
      "_type": "vcSteps",
      "head": {
        "_type": "vcHead",
        "badge": "Our implementation method",
        "heading": "How a Fruition *implementation runs*",
        "lead": "The same five stages sit behind every package. Training & Optimisation compresses them; the other two run each in full."
      },
      "items": [
        {
          "_key": "3fe76bd05e63",
          "_type": "vcStep",
          "body": "We map team structures, current tools and the steps people actually follow, then agree the future process with the people who run it.",
          "bullets": [],
          "n": "01",
          "title": "Discovery and process analysis"
        },
        {
          "_key": "81a9db5a5289",
          "_type": "vcStep",
          "body": "Boards, columns, views, dashboards, forms and permissions built to the agreed design, using monday.com's native features first.",
          "bullets": [],
          "n": "02",
          "title": "Configuration and customisation"
        },
        {
          "_key": "10122353d972",
          "_type": "vcStep",
          "body": "Data moved from spreadsheets or legacy tools, and integrations set up to systems such as Xero, HubSpot, Salesforce, Outlook, Slack or Jira.",
          "bullets": [],
          "n": "03",
          "title": "Data migration and integration"
        },
        {
          "_key": "e5fe6ea5f7c8",
          "_type": "vcStep",
          "body": "Role-based training for end users, champions and admins, with documentation written for your workflows rather than generic guides.",
          "bullets": [],
          "n": "04",
          "title": "Training and onboarding"
        },
        {
          "_key": "a6f967bf3da3",
          "_type": "vcStep",
          "body": "A supported go-live, adoption checks and a clear path to a Deployed Engineer or ad-hoc help as your processes change.",
          "bullets": [],
          "n": "05",
          "title": "Go-live and ongoing support"
        }
      ],
      "layout": "steps s5",
      "titleClass": "title",
      "tone": "alt"
    },
    {
      "_key": "cef2763122db",
      "_type": "vcCards",
      "head": {
        "_type": "vcHead",
        "badge": "Why Fruition",
        "heading": "Built to be adopted, *not abandoned*",
        "lead": "Process first, delivered in your time zone, by a team that started inside monday.com."
      },
      "items": [
        {
          "_key": "1bbc770beb70",
          "_type": "vcItem",
          "body": "We map and agree the process before we build. It's why our implementations get adopted instead of abandoned after the first month.",

        {
          "_key": "e869e44cc19a",
          "_type": "vcItem",
          "body": "Fruition was founded by Josh Jebathilak after about six years in sales leadership at monday.com, and is a monday.com Platinum Partner.",
          "title": "monday.com insiders"

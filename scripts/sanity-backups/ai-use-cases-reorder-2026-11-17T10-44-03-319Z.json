      "overrides": [
        {
          "_key": "e6b28f426921",
          "_type": "vcTileOverride",
          "id": "uc-fruition-demo-crm-erp",
          "summary": "Sales demos and new hires needed a realistic, end-to-end reference system with orders, inventory, production and finance working together.",
          "title": "Demo CRM and ERP reference environment"
        },
        {
          "_key": "761d338adbfa",
          "_type": "vcTileOverride",
          "id": "uc-fruition-outbound-lead-engine",
          "metric": "27 POSITIVE REPLIES",
          "summary": "Revenue relied on inbound and referrals. The goal was predictable outbound on our own infrastructure, without an agency or a team of SDRs.",
          "title": "AI outbound lead engine"
        },
        {
          "_key": "16464fbcafb4",
          "_type": "vcTileOverride",
          "id": "uc-fruition-time-tracking-hours-reporting",
          "metric": "3 REGIONS",
          "summary": "Logged hours did not reliably land on the right monday.com project, causing double entries and overruns that surfaced late.",
          "title": "Time tracking sync and hours reporting"
        },
        {
          "_key": "8716196b7062",
          "_type": "vcTileOverride",
          "id": "uc-fruition-marketa",
          "summary": "An always-on agent researches and drafts against a shared knowledge base, so the team can publish more industry-specific content without adding headcount.",
          "title": "Autonomous AI marketing agent"
        },
        {
          "_key": "fd6551df0084",
          "_type": "vcTileOverride",
          "id": "uc-fruition-meeting-to-action",
          "summary": "Call notes and follow-up emails took consultant time, and action items did not reliably reach the right person, board or client folder.",
          "title": "Meeting-to-action follow-up automation"
        },
        {
          "_key": "4525bf294314",
          "_type": "vcTileOverride",
          "id": "uc-fruition-proposal-generator",
          "metric": "<30 MIN PER PROPOSAL",
          "summary": "Writing a costed, on-brand proposal after every discovery call took hours and produced inconsistent documents.",
          "title": "Discovery call to proposal generator"
        },
        {
          "_key": "9715d19363d8",
          "_type": "vcTileOverride",
          "id": "uc-fruition-google-ads-agent",
          "summary": "Paid search across three brands and five markets needs constant keyword pruning, ad copy and bid changes, once handled by a dedicated SEM contractor.",
          "title": "AI-assisted Google Ads agent"
        },
        {
          "_key": "f8b3cddbbd2f",
          "_type": "vcTileOverride",
          "id": "uc-fruition-website-rebuild",
          "summary": "The Wix site had security gaps, limited AEO/SEO control and could not take programmatic content from agents.",
          "title": "Secure headless website rebuild"
        },
        {
          "_key": "9c78ca9cdb49",
          "_type": "vcTileOverride",
          "id": "uc-fruition-ops-dashboards",
          "summary": "Project leads were overloaded and leadership lacked one view of workload, bench utilisation, pipeline against capacity and revenue per head.",
          "title": "Leadership workload and capacity dashboards"
        },
        {
          "_key": "fd3e3f35e858",
          "_type": "vcTileOverride",
          "id": "uc-fruition-security-uplift",
          "metric": "26 USERS",
          "summary": "A government-sector security questionnaire exposed gaps in encryption, device management and MFA across a team in three regions.",
          "title": "Security uplift for a distributed team"
        },
        {
          "_key": "3689c12b56f7",
          "_type": "vcTileOverride",
          "id": "uc-fruition-proploy",
          "summary": "Businesses struggle to compare software and find a vetted partner, so a two-sided marketplace matches buyers with products and experts.",
          "title": "Proploy AI software marketplace"
        },
        {
          "_key": "d4fec904e69b",
          "_type": "vcTileOverride",
          "id": "uc-fruition-social-publishing",
          "summary": "Every blog and social post was scheduled by hand across brands, channels and profiles, so approved content was not consistently redistributed.",
          "title": "Automated blog-to-social publishing"
        },
        {
          "_key": "edd758de3064",
          "_type": "vcTileOverride",
          "id": "uc-fruition-inbound-lead-capture",
          "summary": "Website bookings, inbound emails and partner referrals did not reliably create a scored lead in the right regional CRM or prompt a timely reply.",
          "title": "Inbound lead capture and routing"
        },
        {
          "_key": "f6ebb33f2539",
          "_type": "vcTileOverride",
          "id": "uc-fruition-sales-to-delivery-handover",
          "summary": "Context gathered in sales was lost at handover, so delivery leads re-asked clients questions, and won Atlassian deals were re-keyed into Jira.",
          "title": "Sales-to-delivery handover with AI client profile"
        },
        {
          "_key": "c9b466100c4b",
          "_type": "vcTileOverride",
          "id": "uc-fruition-landing-page-agent",
          "metric": "11 LANDING PAGES",
          "summary": "Every new campaign or regional landing page needed manual design and build work, slowing ad launches.",
          "title": "AI landing page build agent"
        },
        {
          "_key": "e17eafc0e1fd",
          "_type": "vcTileOverride",
          "id": "uc-fruition-skills-solution-library",
          "summary": "Claude skills, past project designs and learnings were hard to find and reuse, so each implementation started from scratch.",
          "title": "Claude skills and solution library"
        },
        {
          "_key": "909ad8546e24",
          "_type": "vcTileOverride",
          "id": "uc-fruition-people-it-requests",
          "summary": "Staff requests for access, HR and payroll came through scattered chats and emails, with onboarding SOPs and reviews not tracked.",
          "title": "People, IT and payroll request hub"
        },
        {
          "_key": "5cb5a7a44a54",
          "_type": "vcTileOverride",
          "id": "uc-fruition-po-to-invoice",
          "metric": "~20 MIN TO SECONDS",
          "summary": "Every purchase order meant re-keying details between email, the work board and the finance system.",
          "title": "Purchase order to invoice automation"
        },
        {
          "_key": "a1e049ee8900",
          "_type": "vcTileOverride",
          "id": "uc-fruition-rfp-responder",
          "summary": "Government tenders were found, classified and answered manually, limiting turnaround and how many bids could be pursued.",
          "title": "AI tender and RFP responder"
        },
        {
          "_key": "8f28abb888a8",
          "_type": "vcTileOverride",
          "id": "uc-fruition-work-order-esign",
          "summary": "Work orders and agreements were assembled and sent for signature by hand, with different legal templates for AU, UK and US.",
          "title": "Work order generation and e-signature"
        },
        {
          "_key": "ebd49437efc9",
          "_type": "vcTileOverride",
          "id": "uc-fruition-ai-executive-assistant",
          "summary": "Executives lose time tracking commitments from meetings and email, and routine tasks were mixed with strategic initiatives.",
          "title": "AI executive assistant for follow-ups"
        },
        {

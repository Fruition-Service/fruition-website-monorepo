          "_type": "vcPartnerStatus",
          "badge": "Partner status",
          "badgeImages": [
            {
              "_key": "a0623428d8db",
              "_type": "vcLogo",
              "alt": "Atlassian Platinum Solution Partner",
              "image": {
                "_type": "image",
                "asset": {
                  "_ref": "image-bbd8251a00797677ebd5bbca9c59326cd10a150d-291x97-png",

          ],
          "heading": "Fruition is a proud *Atlassian Platinum Solution Partner.*",
          "points": [
            {
              "_key": "bf3bb83dd5f7",
              "_type": "vcPoint",
              "body": "Every Atlassian project is run by consultants certified on the platform, not generalists learning on your time.",
              "n": "01",
              "title": "Certified consultants"
            },
            {
              "_key": "52c002c3619d",
              "_type": "vcPoint",
              "body": "Partner status gives us Atlassian's partner team and roadmap briefings, so issues are escalated properly.",
              "n": "02",
              "title": "A direct line to Atlassian"
            },
            {
              "_key": "0036eb9ead22",
              "_type": "vcPoint",
              "body": "We set up Atlassian alongside the other tools you run, and tell you plainly when it is not the right fit.",
              "n": "03",
              "title": "Built for your whole stack"
            }
          ],
          "tone": "plain"
        },
        {
          "_key": "d50039e850bf",
          "_type": "vcCards",
          "head": {
            "_type": "vcHead",
            "badge": "Why Atlassian",
            "heading": "What it does *best.*",
            "lead": "Four things teams use Atlassian for every day."
          },
          "imageFrame": "w4-img",
          "items": [
            {
              "_key": "8b8c38b640d2",
              "_type": "vcItem",
              "body": "Jira boards, list, timeline and capacity views track work from request to done. Teams and AI agents can be assigned the same work items.",
              "image": {
                "_type": "image",
                "alt": "Boards for every team in Atlassian",
                "asset": {
                  "_ref": "image-a3383d0b299e26a37035d070f622166eeffd7101-1200x484-webp",
                  "_type": "reference"
                }
              },
              "label": "01",
              "title": "Boards for every team"
            },
            {
              "_key": "0630d19c8cff",
              "_type": "vcItem",
              "body": "Confluence pages hold plans, specs and decisions in one place. Built-in review workflows let named approvers sign off on a page.",
              "image": {
                "_type": "image",
                "alt": "Confluence knowledge pages in Atlassian",
                "asset": {
                  "_ref": "image-55e311480090cb1523276ddb8a5b88f0c1d79703-1200x675-webp",
                  "_type": "reference"
                }
              },
              "label": "02",
              "title": "Confluence knowledge pages"
            },
            {
              "_key": "b0f88d2a24b1",
              "_type": "vcItem",
              "body": "Jira Service Management turns requests into ticket queues with request types, statuses and time-to-resolution targets for support and IT teams.",
              "image": {
                "_type": "image",
                "alt": "Service desk queues in Atlassian",
                "asset": {
                  "_ref": "image-78103aaa2eb88f6311905ec3101545a348ebc412-1200x675-webp",
                  "_type": "reference"
                }
              },
              "label": "03",
              "title": "Service desk queues"
            },
            {
              "_key": "7b48b467fb7b",
              "_type": "vcItem",
              "body": "Build rules from triggers such as issue created, commented or transitioned, then add conditions and actions to cut repetitive manual updates.",
              "image": {
                "_type": "image",
                "alt": "No-code automation rules in Atlassian",
                "asset": {
                  "_ref": "image-5666cfd151c7843e2280499dd6c415c6916ca789-1200x1000-webp",
                  "_type": "reference"
                }
              },
              "label": "04",
              "title": "No-code automation rules"
            }
          ],
          "layout": "why4",
          "tone": "alt"
        },
        {
          "_key": "167902d8089d",
          "_type": "vcSteps",
          "head": {
            "_type": "vcHead",
            "badge": "Our approach",
            "heading": "How we deliver *Atlassian.*",
            "lead": "Three steps, the same consultant from scoping to support."
          },
          "items": [
            {
              "_key": "90a8c44f8045",
              "_type": "vcStep",
              "body": "Most Jira pain is configuration debt, not platform failure. We fix workflow sprawl, permissions and plugin bloat first.",
              "bullets": [],
              "n": "01",
              "title": "Optimise what you have"
            },
            {
              "_key": "fd4ce9e43285",
              "_type": "vcStep",
              "body": "Jira connected to monday.com, Slack and your delivery stack, so dev tools stop creating a visibility gap for leadership.",
              "bullets": [],
              "n": "02",
              "title": "Integrate, don’t isolate"
            },
            {
              "_key": "b12da1058cd5",
              "_type": "vcStep",
              "body": "As both an Atlassian and monday.com Platinum partner, we’re the rare firm that migrates in either direction and tells you honestly which fits.",
              "bullets": [],
              "n": "03",
              "title": "Migrate when it’s right"
            }
          ],
          "layout": "steps",
          "tone": "plain"
        },
        {
          "_key": "d95f95d8e79e",
          "_type": "vcCases",
          "cases": [
            {
              "_key": "93bc539f88f8",
              "_ref": "vcCase-kinetic-solutions",
              "_type": "reference"
            },
            {
              "_key": "738c160d67d7",
              "_ref": "vcCase-long-term-care-consultants",
              "_type": "reference"
            }
          ],
          "head": {
            "_type": "vcHead",
            "badge": "Case studies",
            "heading": "Clients on *Atlassian.*",
            "lead": "Named clients and what we built for them on Atlassian."
          },
          "tone": "alt"
        },
        {
          "_key": "b57720be47ca",
          "_type": "vcAudit",
          "cta": {
            "_type": "vcCta",
            "arrow": true,
            "href": "#book",
            "label": "Book a Jira health check",
            "style": "primary"
          },
          "heading": "Is Jira *slowing your teams down?*",
          "text": "A free 30-minute health check of your Jira and Confluence setup.",
          "tone": "plain"
        },
        {
          "_key": "1de14271c602",
          "_type": "vcCards",
          "head": {
            "_type": "vcHead",
            "badge": "What we deliver",
            "heading": "Our *Atlassian services.*",
            "lead": "Fixed scope and a fixed fee for each piece of work."
          },
          "items": [
            {
              "_key": "5e94564e710e",
              "_type": "vcItem",
              "body": "Project configuration, workflow design, permission schemes, and the cleanup engagements that rescue sprawling instances.",
              "href": "/atlassian-consulting#jira",
              "label": "01",
              "linkLabel": "See how we run it",
              "title": "Jira implementation & optimisation"
            },
            {
              "_key": "7c56f95c41a6",
              "_type": "vcItem",
              "body": "Space architecture, template systems, and governance that make Confluence a knowledge base instead of a document graveyard.",
              "href": "/atlassian-consulting#confluence",
              "label": "02",
              "linkLabel": "See how we run it",
              "title": "Confluence knowledge systems"
            },
            {
              "_key": "190eb021ef85",
              "_type": "vcItem",
              "body": "ITSM builds: service desks, SLAs, asset management, and customer portals.",
              "href": "/atlassian-consulting#jsm",
              "label": "03",
              "linkLabel": "See how we run it",
              "title": "Jira Service Management"
            },
            {
              "_key": "b69a545a061e",
              "_type": "vcItem",
              "body": "Structured cross-platform migration when teams need business-wide visibility Jira can’t give them.",
              "href": "/atlassian-consulting#migration",
              "label": "04",
              "linkLabel": "See how we run it",
              "title": "Jira → monday migration"
            }
          ],
          "layout": "cards4",
          "tone": "plain"
        },
        {
          "_key": "pagespecific-atlassian-partner",
          "_type": "vcCards",
          "anchor": "partner",
          "head": {
            "_type": "vcHead",
            "badge": "Atlassian Certified Partner",
            "heading": "Accelerate Your Enterprise & Maximise Efficiency *with Atlassian*",
            "lead": "We modernise your business with intelligent Atlassian solutions, streamlined services, and expert migration that deliver measurable ROI across your entire organization."
          },
          "items": [
            {
              "_key": "pagespecific-atlassian-partner-01",
              "_type": "vcItem",
              "body": "As former Atlassian team members, we're on the edge of what customers are doing & we'll help build out ROVO Atlassian AI agents that save you time and have a clear ROI. Get in touch to explore how Rovo brings AI-driven simplicity to your workflows, creating virtual agents for service management, chat support for Jira issues, and automating search across Confluence and Jira.",
              "label": "01",
              "title": "#1 in ROVO"
            },
            {
              "_key": "pagespecific-atlassian-partner-02",
              "_type": "vcItem",
              "body": "Transform customer and employee support and elevate your service with intelligent service management solutions. Eliminate disconnects between development and operations. Jira Service Management offers seamless integration on a unified platform.",
              "label": "02",
              "title": "Service Management"
            },
            {
              "_key": "pagespecific-atlassian-partner-03",
              "_type": "vcItem",
              "body": "Future-proof your Atlassian investment with secure and optimised expert cloud migration services. Our certified partnership delivers seamless Monday Atlassian integration, Jira Monday connector solutions, and comprehensive API integration with workflow automation for optimised tool connectivity.",
              "label": "03",
              "title": "Cloud Migration"
            }
          ],
          "layout": "cards3",
          "pageSpecific": true,
          "pageSpecificNote": "Page-specific to /atlassian-consulting, outside the partner page template. Copy of the \"Accelerate Your Enterprise & Maximise Efficiency with Atlassian\" block of the retired /partnerships/certified-atlassian-partner page, folded in on 13 Nov 2026 (Edward). The old URL 301s to this anchor. The unsourced 277% ROI claim in the Service Management item was removed.",
          "tone": "alt"
        },
        {
          "_key": "pagespecific-atlassian-jira",
          "_type": "vcDeepDive",
          "anchor": "jira",
          "cards": [
            {
              "_key": "7cf30f13973f",
              "_type": "vcDeepDiveCard",
              "body": "Greenfield Jira setups with disciplined project templates, workflow standards, and governance from day one.",
              "title": "New implementations"
            },
            {
              "_key": "71c1916bebfb",
              "_type": "vcDeepDiveCard",
              "body": "The 3–4 week cleanup: workflow consolidation, permission untangling, plugin audit, and board restructure.",
              "title": "Instance rescue"
            },
            {
              "_key": "9568b5061946",
              "_type": "vcDeepDiveCard",
              "body": "Automation rules, cross-project dependencies, and release management for scaled delivery organisations.",
              "title": "Advanced workflows"
            },
            {
              "_key": "e23b070c1124",
              "_type": "vcDeepDiveCard",
              "body": "GitHub, Bitbucket, monday.com, Slack, and CI/CD pipeline connections.",
              "title": "Integration builds"
            }
          ],
          "cardsHeading": "Jira engagements we run.",
          "head": {
            "_type": "vcHead",
            "badge": "Jira",
            "heading": "Jira that developers tolerate *and leaders can read*",
            "lead": "Fruition delivers Jira consulting across Australia, the UK, and the US: implementations that start clean, rescues that untangle years of configuration debt, and integrations that end the visibility gap."
          },
          "pageSpecific": true,
          "pageSpecificNote": "Page-specific to /atlassian-consulting, outside the partner page template. Carries the copy of the retired leaf page (PR #415, 5 Nov 2026), restored after the Version C rollout dropped it (Vadim, SEO, 12 Nov 2026). The old leaf URL 301s to this anchor.",
          "steps": [
            {
              "_key": "7dd1521dce95",
              "_type": "vcDeepDiveStep",
              "body": "Every status, transition, and required field must earn its place. Most Jira misery is workflow maximalism nobody remembers approving.",
              "title": "Workflow minimalism"
            },
            {
              "_key": "8fd4ebe52902",
              "_type": "vcDeepDiveStep",
              "body": "Scheme consolidation and role-based access that admins can actually reason about, and auditors can actually audit.",
              "title": "Permission sanity"
            },
            {
              "_key": "51fa8c049b4d",
              "_type": "vcDeepDiveStep",
              "body": "Jira↔monday.com and Jira↔Slack integrations that give non-technical stakeholders visibility without Jira licences or training.",
              "title": "Business-tool bridges"
            }
          ],
          "stepsHeading": "Configuration discipline.",
          "tone": "alt"
        },
        {
          "_key": "pagespecific-atlassian-confluence",
          "_type": "vcDeepDive",
          "anchor": "confluence",
          "cards": [
            {
              "_key": "9f1d6da44e64",
              "_type": "vcDeepDiveCard",
              "body": "Space design, page hierarchies, labels, and navigation for organisations from 50 to 5,000 users.",
              "title": "Knowledge architecture"

    {
      "_key": "910fd7e52579",
      "_type": "vcCards",
      "head": {
        "_type": "vcHead",
        "badge": "Security",
        "heading": "The security standards *agencies cannot compromise on.*",
        "lead": "Public-sector workflows carry records that must not leak. These are the controls we configure before any sensitive data moves in."
      },
      "items": [
        {
          "_key": "4cb56ad78c74",
          "_type": "vcItem",
          "body": "People see only the records they are assigned to, non-owners edit only their own work, and guests never reach the wider workspace.",
          "label": "01",
          "title": "Item-level permissions"
        },
        {
          "_key": "622600bfa314",
          "_type": "vcItem",
          "body": "Encryption, comprehensive audit logging, HIPAA support through a Business Associate Agreement and an emergency lockdown control.",
          "label": "02",
          "title": "Compliance-grade data handling"
        },
        {
          "_key": "de03be383ecb",
          "_type": "vcItem",
          "body": "IP allowlisting, single sign-on with Azure AD, Okta or SAML, multi-factor authentication and admin-level controls on public sharing.",
          "label": "03",
          "title": "Access control and identity"
        }
      ],
      "layout": "cards3",
      "tone": "plain"
    },

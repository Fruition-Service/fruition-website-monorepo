    {
      "_key": "2e4abff3584b",
      "_type": "vcSteps",
      "head": {
        "_type": "vcHead",
        "badge": "Our approach",
        "heading": "Modernise public services *without the IT queue.*",
        "lead": "Secure workflow, case management and governed AI, rolled out in a way agencies can audit."
      },
      "items": [
        {
          "_key": "637d4f4922ce",
          "_type": "vcStep",
          "body": "Non-IT teams build and adapt their own workflows on approved platforms, without waiting in the IT queue.",
          "n": "01",
          "title": "Change without bottlenecks"
        },
        {
          "_key": "608b59f4cb7a",
          "_type": "vcStep",
          "body": "Critical processes and decision protocols captured in one system, so services continue when experienced staff move on.",
          "n": "02",
          "title": "Knowledge that stays"
        },
        {
          "_key": "a71d7df1e53b",
          "_type": "vcStep",
          "body": "Automated request tracking, case management and real-time status updates that make public services more responsive.",
          "n": "03",
          "title": "Faster citizen service"
        }
      ],

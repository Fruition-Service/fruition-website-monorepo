{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Thin wrapper around the OpenNext worker (.open-next/worker.js) that adds
  // edge and browser caching for /_next/image. See workers/site-entry.ts.
  "main": "workers/site-entry.ts",
  "name": "fruition-landing",
  "workers_dev": true,
  "preview_urls": true,
  // No routes: the site's hostnames belong to fruition-edge (workers/edge), a
  // small HTML cache in front of this Worker that reaches it through a service
  // binding. Do not add routes back here; a route on both Workers fails deploy.
  // The legacy fruitionmonday.com hosts go through fruition-edge too and still
  // reach src/middleware.ts here, which 301s them to the canonical host.
  // wrangler bundles with esbuild `keepNames` by default, which injects
  // `__name(fn, "fn")` calls. Libraries that serialise a function into an
  // inline <script> via `.toString()` (next-themes' theme bootstrap, rendered
  // on every page) then ship that call to the browser, where `__name` does not
  // exist: an uncaught "__name is not defined" on every load and a theme class
  // that is never applied before hydration. Nothing in the app reads minified
  // function/class `.name`s, so turning it off is safe.
  "keep_names": false,
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      // OpenNext incremental (ISR) cache — see open-next.config.ts.
      "binding": "NEXT_INC_CACHE_KV",
      "id": "74a7eb0e0e4542e8a9acdbc178a849af"
    },
    {
      // OpenNext tag cache — the store `revalidatePath()` writes to, so an
      // on-demand revalidation (e.g. updating a blog post from /internal)
      // actually drops the cached page. Without it the adapter falls back to
      // the "dummy" tag cache and revalidation is a silent no-op.
      "binding": "NEXT_TAG_CACHE_KV",
      "id": "97b71b6dcfc84ceba8b7f3e77773b243"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fruition-landing"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_OAIQ_PIXEL_ID": "RNJ1b2hooXBRHiYSWb3K6h"
  },
  "images": {
    "binding": "IMAGES"
  }
}
